+
+    // Verify output energy
+    float maxInst = 0.0f;
+    for (int i = 0; i < N; ++i) {
+        maxInst = std::max(maxInst, std::abs(inst_l[i]));
+    }
+    EXPECT_GT(maxInst, 0.5f); // 440Hz sine wave should be primarily in Instruments ("Other")
+}
